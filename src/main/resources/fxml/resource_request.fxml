<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Priority Resource Request Submission & Fulfillment
     Target Roles: Zone Coordinator (submit), Warehouse Manager (fulfill), System Admin (all)
     Key Features: priority_score generated column, urgency tags, Fulfill button
                   that triggers fn_allocate_resources() atomic transfer
     Layout: Adapted from Hostel-Management-System allocation.fxml pattern -->
<BorderPane minHeight="600.0" minWidth="900.0" prefHeight="850.0" prefWidth="1300.0"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.groupa13.disasterrelief.controller.ResourceRequestController">
   <top>
      <HBox alignment="CENTER_LEFT" minHeight="72.0" spacing="20.0" styleClass="header-bar" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#goBack" styleClass="btn-back" text="Dashboard">
               <graphic>
                  <FontIcon iconLiteral="fas-arrow-left" styleClass="icon-sm" />
               </graphic>
            </Button>
            <Label styleClass="page-title" text="Resource Requests" />
            <Label fx:id="roleBadge" text="" />
         </children>
      </HBox>
   </top>
   <left>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxWidth="420.0" minWidth="280.0" prefWidth="380.0" vbarPolicy="AS_NEEDED" BorderPane.alignment="CENTER">
         <content>
            <VBox minWidth="280.0" spacing="4.0" styleClass="form-panel panel-card">
               <padding>
                  <Insets bottom="40.0" left="12.0" right="12.0" top="12.0" />
               </padding>
               <children>
                  <Label fx:id="errorLabel" maxWidth="1.7976931348623157E308" minHeight="18.0" styleClass="login-error" text="" wrapText="true" />

                  <Label styleClass="field-label" text="Request ID" />
                  <TextField fx:id="requestIdField" promptText="Auto-generated on submit" />

                  <!-- Zone selection (pre-filtered for Zone Coordinators) -->
                  <Label styleClass="field-label" text="Zone" />
                  <ComboBox fx:id="zoneCombo" maxWidth="1.7976931348623157E308" promptText="Select zone..." />

                  <!-- Resource selection -->
                  <Label styleClass="field-label" text="Resource" />
                  <ComboBox fx:id="resourceCombo" maxWidth="1.7976931348623157E308" promptText="Select resource..." />

                  <Label styleClass="field-label" text="Quantity Requested" />
                  <TextField fx:id="quantityField" promptText="e.g. 100" />

                  <!-- Urgency level (drives priority_score generated column) -->
                  <Label styleClass="field-label" text="Urgency" />
                  <ComboBox fx:id="urgencyCombo" maxWidth="1.7976931348623157E308" />

                  <!-- Status (read-only context) -->
                  <Label styleClass="field-label" text="Status" />
                  <ComboBox fx:id="statusCombo" maxWidth="1.7976931348623157E308" />

                  <Separator prefWidth="200.0" />

                  <!-- Action Buttons -->
                  <HBox minHeight="48.0" spacing="8.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSubmitRequest" styleClass="btn-primary" text="Submit Request" HBox.hgrow="ALWAYS">
                           <graphic>
                              <FontIcon iconLiteral="fas-paper-plane" styleClass="icon-sm" />
                           </graphic>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleUpdate" styleClass="btn-success" text="Update" HBox.hgrow="ALWAYS">
                           <graphic>
                              <FontIcon iconLiteral="fas-sync-alt" styleClass="icon-sm" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
                  <HBox minHeight="48.0" spacing="8.0">
                     <children>
                        <!-- Fulfill button — triggers fn_allocate_resources() atomic transfer -->
                        <Button fx:id="btnFulfill" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleFulfill" styleClass="btn-nav-green" text="⚡ Fulfill Request" HBox.hgrow="ALWAYS">
                           <graphic>
                              <FontIcon iconLiteral="fas-check-double" styleClass="icon-sm" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
                  <HBox minHeight="48.0" spacing="8.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCancel" styleClass="btn-danger" text="Cancel Request" HBox.hgrow="ALWAYS">
                           <graphic>
                              <FontIcon iconLiteral="fas-times-circle" styleClass="icon-sm" />
                           </graphic>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleFindById" styleClass="btn-neutral" text="Find by ID" HBox.hgrow="ALWAYS">
                           <graphic>
                              <FontIcon iconLiteral="fas-search" styleClass="icon-sm" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
                  <HBox minHeight="48.0" spacing="8.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleFilterByStatus" styleClass="btn-neutral" text="Filter by Status" HBox.hgrow="ALWAYS">
                           <graphic>
                              <FontIcon iconLiteral="fas-filter" styleClass="icon-sm" />
                           </graphic>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleClear" styleClass="btn-outline" text="Clear" HBox.hgrow="ALWAYS">
                           <graphic>
                              <FontIcon iconLiteral="fas-eraser" styleClass="icon-sm" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </left>
   <center>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10.0" styleClass="content-area panel-card" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="24.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <TableView fx:id="requestTable" minHeight="200.0" minWidth="400.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colRequestId" minWidth="64.0" prefWidth="70.0" text="ID" />
                  <TableColumn fx:id="colZoneName" minWidth="100.0" prefWidth="140.0" text="Zone" />
                  <TableColumn fx:id="colResourceName" minWidth="100.0" prefWidth="150.0" text="Resource" />
                  <TableColumn fx:id="colQuantity" minWidth="60.0" prefWidth="80.0" text="Qty" />
                  <TableColumn fx:id="colUrgency" minWidth="70.0" prefWidth="90.0" text="Urgency" />
                  <TableColumn fx:id="colPriorityScore" minWidth="70.0" prefWidth="80.0" text="Priority" />
                  <TableColumn fx:id="colStatus" minWidth="80.0" prefWidth="100.0" text="Status" />
                  <TableColumn fx:id="colRequestedAt" minWidth="130.0" prefWidth="160.0" text="Requested At" />
                  <TableColumn fx:id="colFulfilledAt" minWidth="130.0" prefWidth="160.0" text="Fulfilled At" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
