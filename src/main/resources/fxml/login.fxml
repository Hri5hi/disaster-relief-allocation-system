<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="700.0" prefWidth="1100.0" styleClass="login-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.groupa13.disasterrelief.controller.LoginController">
   <children>
      <VBox maxWidth="834.0" prefHeight="640.0" prefWidth="834.0" styleClass="login-card">
         <children>
            <Label alignment="CENTER" styleClass="login-title" text="Disaster Relief Resource Allocation System" wrapText="true" />
            <Label alignment="CENTER" styleClass="login-subtitle" text="Sign in to continue" />
            <Label styleClass="login-label" text="User ID" />
            <TextField fx:id="userIdField" promptText="Enter your user ID" />
            <Label styleClass="login-label" text="Password" />
            <PasswordField fx:id="passwordField" promptText="Enter your password" />
            <Label styleClass="login-label" text="Role" />
            <ComboBox fx:id="roleCombo" maxWidth="1.7976931348623157E308" promptText="Select your role" />
            <Region prefHeight="10.0" prefWidth="200.0" />
            <Button fx:id="loginButton" defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogin" styleClass="btn-login" text="Sign In">
               <graphic>
                  <FontIcon iconLiteral="fas-sign-in-alt" styleClass="icon-sm" />
               </graphic>
            </Button>
            <Label fx:id="errorLabel" prefHeight="0.0" prefWidth="200.0" styleClass="login-error" text="" wrapText="true" />
         </children>
      </VBox>
   </children>
</StackPane>
