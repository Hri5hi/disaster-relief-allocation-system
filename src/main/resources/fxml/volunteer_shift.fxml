<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Volunteer Shift Scheduling (conflict-free via DB exclusion constraint)
     Target Roles: Volunteer Coordinator, System Admin
     Key Features: tsrange duty period, zone dropdown, volunteer dropdown,
                   DB-level EXCLUDE USING gist prevents double-booking
     Layout: Adapted from Hostel-Management-System allocation.fxml pattern -->
<BorderPane minHeight="600.0" minWidth="900.0" prefHeight="850.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.groupa13.disasterrelief.controller.VolunteerShiftController">
   <top>
      <HBox alignment="CENTER_LEFT" minHeight="72.0" spacing="20.0" styleClass="header-bar" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#goBack" styleClass="btn-back" text="Dashboard">
               <graphic>
                  <FontIcon iconLiteral="fas-arrow-left" styleClass="icon-sm" />
               </graphic>
            </Button>
            <Label styleClass="page-title" text="Volunteer Shift Scheduling" />
            <Label fx:id="roleBadge" styleClass="role-badge-volunteer" text="" />
         </children>
      </HBox>
   </top>
   <left>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxWidth="420.0" minWidth="280.0" prefWidth="380.0" vbarPolicy="AS_NEEDED" BorderPane.alignment="CENTER">
         <content>
            <VBox minWidth="280.0" spacing="4.0" styleClass="form-panel panel-card">
               <padding>
                  <Insets bottom="40.0" left="12.0" right="12.0" top="12.0" />
               </padding>
               <children>
                  <Label fx:id="errorLabel" maxWidth="1.7976931348623157E308" minHeight="18.0" styleClass="login-error" text="" wrapText="true" />

                  <!-- Shift ID -->
                  <Label styleClass="field-label" text="Shift ID" />
                  <TextField fx:id="shiftIdField" promptText="Auto-generated on create" />

                  <!-- Volunteer selection -->
                  <Label styleClass="field-label" text="Volunteer" />
                  <ComboBox fx:id="volunteerCombo" maxWidth="1.7976931348623157E308" promptText="Select volunteer..." />

                  <!-- Zone assignment -->
                  <Label styleClass="field-label" text="Zone" />
                  <ComboBox fx:id="zoneCombo" maxWidth="1.7976931348623157E308" promptText="Select zone..." />

                  <!-- Duty Period — PostgreSQL tsrange input -->
                  <Label styleClass="field-label" text="Duty Start (yyyy-MM-dd HH:mm)" />
                  <TextField fx:id="dutyStartField" promptText="e.g. 2026-07-09 08:00" />

                  <Label styleClass="field-label" text="Duty End (yyyy-MM-dd HH:mm)" />
                  <TextField fx:id="dutyEndField" promptText="e.g. 2026-07-09 20:00" />

                  <Separator prefWidth="200.0" />

                  <!-- Action Buttons -->
                  <HBox minHeight="48.0" spacing="8.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCreate" styleClass="btn-primary" text="Schedule Shift" HBox.hgrow="ALWAYS">
                           <graphic>
                              <FontIcon iconLiteral="fas-calendar-plus" styleClass="icon-sm" />
                           </graphic>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleUpdate" styleClass="btn-success" text="Update" HBox.hgrow="ALWAYS">
                           <graphic>
                              <FontIcon iconLiteral="fas-sync-alt" styleClass="icon-sm" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
                  <HBox minHeight="48.0" spacing="8.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDelete" styleClass="btn-danger" text="Cancel Shift" HBox.hgrow="ALWAYS">
                           <graphic>
                              <FontIcon iconLiteral="fas-calendar-times" styleClass="icon-sm" />
                           </graphic>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleFindById" styleClass="btn-neutral" text="Find by ID" HBox.hgrow="ALWAYS">
                           <graphic>
                              <FontIcon iconLiteral="fas-search" styleClass="icon-sm" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
                  <HBox minHeight="48.0" spacing="8.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleFindByVolunteer" styleClass="btn-neutral" text="Shifts for Selected Volunteer" HBox.hgrow="ALWAYS">
                           <graphic>
                              <FontIcon iconLiteral="fas-user-clock" styleClass="icon-sm" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
                  <HBox minHeight="48.0" spacing="8.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleClear" styleClass="btn-outline" text="Clear" HBox.hgrow="ALWAYS">
                           <graphic>
                              <FontIcon iconLiteral="fas-eraser" styleClass="icon-sm" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </left>
   <center>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10.0" styleClass="content-area panel-card" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="24.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <TableView fx:id="shiftTable" minHeight="200.0" minWidth="400.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colShiftId" minWidth="64.0" prefWidth="80.0" text="Shift ID" />
                  <TableColumn fx:id="colVolunteerName" minWidth="120.0" prefWidth="180.0" text="Volunteer" />
                  <TableColumn fx:id="colZoneName" minWidth="120.0" prefWidth="180.0" text="Zone" />
                  <TableColumn fx:id="colDutyPeriod" minWidth="200.0" prefWidth="320.0" text="Duty Period (tsrange)" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
