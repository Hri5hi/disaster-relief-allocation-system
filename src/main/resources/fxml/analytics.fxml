<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane minHeight="640.0" minWidth="860.0" prefHeight="880.0" prefWidth="1300.0"
            styleClass="workspace-root"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.groupa13.disasterrelief.controller.AnalyticsController">
   <top>
      <VBox spacing="12.0" styleClass="header-bar, screen-header, analytics-header" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#goBack" styleClass="btn-back" text="Dashboard">
                     <graphic>
                        <FontIcon iconLiteral="fas-arrow-left" styleClass="icon-sm" />
                     </graphic>
                  </Button>
                  <VBox spacing="2.0">
                     <children>
                        <Label fx:id="pageTitleLabel" styleClass="page-title, screen-title" text="Analytics &amp; Reports" />
                        <Label fx:id="pageSubtitleLabel" styleClass="screen-subtitle"
                               text="Monitor shortages, inventory mix, consumption, and distribution activity."
                               wrapText="true" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="roleBadge" styleClass="role-badge-admin" text="SYSTEM ADMIN" />
               </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" minHeight="62.0" spacing="12.0" styleClass="filter-surface">
               <children>
                  <FontIcon iconLiteral="fas-filter" styleClass="filter-icon" />
                  <VBox spacing="1.0">
                     <children>
                        <Label styleClass="filter-title" text="Disaster scope" />
                        <Label styleClass="filter-description" text="Choose an active disaster to refresh every visible report." />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="disasterFilterCombo" minWidth="190.0" prefWidth="280.0" promptText="Select an active disaster" />
                  <Button fx:id="btnRefresh" mnemonicParsing="false" onAction="#handleRefresh" styleClass="btn-primary, analytics-refresh" text="Refresh reports">
                     <graphic>
                        <FontIcon iconLiteral="fas-sync-alt" styleClass="icon-sm" />
                     </graphic>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
            spacing="10.0" styleClass="content-area, analytics-content" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="errorLabel" maxWidth="1.7976931348623157E308" minHeight="0.0"
                   styleClass="login-error, feedback-label" text="" wrapText="true" />
            <TabPane fx:id="analyticsTabPane" styleClass="analytics-tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
               <tabs>
                  <Tab fx:id="deficitTab" text="Zone Deficit">
                     <content>
                        <VBox spacing="14.0" styleClass="analytics-panel">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <FontIcon iconLiteral="fas-exclamation-triangle" styleClass="panel-heading-icon, warning-icon" />
                                    <VBox spacing="2.0">
                                       <children>
                                          <Label styleClass="panel-title" text="Zone deficit status" />
                                          <Label styleClass="panel-description"
                                                 text="Compare required quantities with available stock and prioritize urgent shortages."
                                                 wrapText="true" />
                                       </children>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label styleClass="data-badge, warning-badge" text="NEED VS STOCK" />
                                 </children>
                              </HBox>
                              <TableView fx:id="deficitTable" minHeight="300.0"
                                         styleClass="records-table" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colDeficitZone" minWidth="150.0" prefWidth="220.0" text="Zone" />
                                    <TableColumn fx:id="colDeficitResource" minWidth="160.0" prefWidth="230.0" text="Resource" />
                                    <TableColumn fx:id="colDeficitRequired" minWidth="95.0" prefWidth="120.0" text="Required" />
                                    <TableColumn fx:id="colDeficitAvailable" minWidth="95.0" prefWidth="120.0" text="Available" />
                                    <TableColumn fx:id="colDeficitAmount" minWidth="90.0" prefWidth="115.0" text="Deficit" />
                                    <TableColumn fx:id="colDeficitUrgency" minWidth="100.0" prefWidth="125.0" text="Urgency" />
                                 </columns>
                              </TableView>
                           </children>
                           <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                        </VBox>
                     </content>
                  </Tab>

                  <Tab fx:id="categoryRollupTab" text="Category Roll-Up">
                     <content>
                        <VBox spacing="10.0" styleClass="analytics-panel">
                           <children>
                              <VBox spacing="2.0">
                                 <children>
                                    <Label styleClass="panel-title" text="Stock by resource category" />
                                    <Label styleClass="panel-description" text="A consolidated inventory view for rapid capacity checks." />
                                 </children>
                              </VBox>
                              <BarChart fx:id="categoryRollupChart" animated="false" legendVisible="false"
                                        styleClass="analytics-chart" title="Total Stock by Resource Category" VBox.vgrow="ALWAYS">
                                 <xAxis><CategoryAxis label="Category" side="BOTTOM" /></xAxis>
                                 <yAxis><NumberAxis label="Total Units" side="LEFT" /></yAxis>
                              </BarChart>
                           </children>
                           <padding><Insets bottom="18.0" left="20.0" right="20.0" top="20.0" /></padding>
                        </VBox>
                     </content>
                  </Tab>

                  <Tab fx:id="consumptionTrendTab" text="Consumption Trends">
                     <content>
                        <VBox spacing="10.0" styleClass="analytics-panel">
                           <children>
                              <VBox spacing="2.0">
                                 <children>
                                    <Label styleClass="panel-title" text="Resource consumption trend" />
                                    <Label styleClass="panel-description" text="Track movement over time to anticipate replenishment needs." />
                                 </children>
                              </VBox>
                              <LineChart fx:id="consumptionTrendChart" animated="false"
                                         styleClass="analytics-chart" title="7-Day Moving Average — Resource Consumption" VBox.vgrow="ALWAYS">
                                 <xAxis><CategoryAxis label="Date" side="BOTTOM" /></xAxis>
                                 <yAxis><NumberAxis label="Units Consumed" side="LEFT" /></yAxis>
                              </LineChart>
                           </children>
                           <padding><Insets bottom="18.0" left="20.0" right="20.0" top="20.0" /></padding>
                        </VBox>
                     </content>
                  </Tab>

                  <Tab fx:id="distributionTab" text="Distribution">
                     <content>
                        <VBox spacing="10.0" styleClass="analytics-panel">
                           <children>
                              <VBox spacing="2.0">
                                 <children>
                                    <Label styleClass="panel-title" text="Distribution activity" />
                                    <Label styleClass="panel-description" text="Review the share of distributed volume by resource category." />
                                 </children>
                              </VBox>
                              <PieChart fx:id="distributionPieChart" legendVisible="true"
                                        styleClass="analytics-chart" title="Distribution Volume by Resource Category" VBox.vgrow="ALWAYS" />
                           </children>
                           <padding><Insets bottom="18.0" left="20.0" right="20.0" top="20.0" /></padding>
                        </VBox>
                     </content>
                  </Tab>
               </tabs>
            </TabPane>
         </children>
         <padding>
            <Insets bottom="18.0" left="22.0" right="22.0" top="14.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
