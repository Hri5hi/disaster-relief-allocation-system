<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane minHeight="640.0" minWidth="1040.0" prefHeight="880.0" prefWidth="1300.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.groupa13.disasterrelief.controller.AnalyticsController">
   <top>
      <HBox alignment="CENTER_LEFT" minHeight="72.0" spacing="16.0" styleClass="header-bar" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#goBack" styleClass="btn-back" text="Dashboard">
               <graphic>
                  <FontIcon iconLiteral="fas-arrow-left" styleClass="icon-sm" />
               </graphic>
            </Button>
            <Label fx:id="pageTitleLabel" styleClass="page-title" text="Analytics &amp; Reports" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="field-label" text="Disaster:" />
            <ComboBox fx:id="disasterFilterCombo" prefWidth="240.0" promptText="All active disasters" />
            <Button fx:id="btnRefresh" mnemonicParsing="false" onAction="#handleRefresh" styleClass="btn-neutral" text="Refresh">
               <graphic>
                  <FontIcon iconLiteral="fas-sync-alt" styleClass="icon-sm" />
               </graphic>
            </Button>
         </children>
      </HBox>
   </top>
   <center>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10.0" styleClass="content-area panel-card" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <Label fx:id="errorLabel" maxWidth="1.7976931348623157E308" minHeight="18.0" styleClass="login-error" text="" wrapText="true" />
            <TabPane fx:id="analyticsTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
               <tabs>

                  <Tab fx:id="deficitTab" text="Zone Deficit Report">
                     <content>
                        <VBox spacing="10.0">
                           <padding>
                              <Insets bottom="12.0" left="4.0" right="4.0" top="12.0" />
                           </padding>
                           <children>
                              <TableView fx:id="deficitTable" minHeight="200.0" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colDeficitZone" minWidth="140.0" prefWidth="200.0" text="Zone" />
                                    <TableColumn fx:id="colDeficitResource" minWidth="140.0" prefWidth="200.0" text="Resource" />
                                    <TableColumn fx:id="colDeficitRequired" minWidth="80.0" prefWidth="100.0" text="Required" />
                                    <TableColumn fx:id="colDeficitAvailable" minWidth="80.0" prefWidth="100.0" text="Available" />
                                    <TableColumn fx:id="colDeficitAmount" minWidth="80.0" prefWidth="100.0" text="Deficit" />
                                    <TableColumn fx:id="colDeficitUrgency" minWidth="90.0" prefWidth="110.0" text="Urgency" />
                                 </columns>
                              </TableView>
                           </children>
                        </VBox>
                     </content>
                  </Tab>

                  <Tab fx:id="categoryRollupTab" text="Category Roll-Up">
                     <content>
                        <VBox spacing="10.0">
                           <padding>
                              <Insets bottom="12.0" left="4.0" right="4.0" top="12.0" />
                           </padding>
                           <children>
                              <BarChart fx:id="categoryRollupChart" animated="false" legendVisible="false" title="Total Stock by Resource Category" VBox.vgrow="ALWAYS">
                                 <xAxis>
                                    <CategoryAxis label="Category" side="BOTTOM" />
                                 </xAxis>
                                 <yAxis>
                                    <NumberAxis label="Total Units" side="LEFT" />
                                 </yAxis>
                              </BarChart>
                           </children>
                        </VBox>
                     </content>
                  </Tab>

                  <Tab fx:id="consumptionTrendTab" text="Consumption Trends">
                     <content>
                        <VBox spacing="10.0">
                           <padding>
                              <Insets bottom="12.0" left="4.0" right="4.0" top="12.0" />
                           </padding>
                           <children>
                              <LineChart fx:id="consumptionTrendChart" animated="false" title="7-Day Moving Average — Resource Consumption" VBox.vgrow="ALWAYS">
                                 <xAxis>
                                    <CategoryAxis label="Date" side="BOTTOM" />
                                 </xAxis>
                                 <yAxis>
                                    <NumberAxis label="Units Consumed" side="LEFT" />
                                 </yAxis>
                              </LineChart>
                           </children>
                        </VBox>
                     </content>
                  </Tab>

                  <Tab fx:id="distributionTab" text="Distribution Analytics">
                     <content>
                        <VBox spacing="10.0">
                           <padding>
                              <Insets bottom="12.0" left="4.0" right="4.0" top="12.0" />
                           </padding>
                           <children>
                              <PieChart fx:id="distributionPieChart" legendVisible="true" title="Distribution Volume by Resource Category" VBox.vgrow="ALWAYS" />
                           </children>
                        </VBox>
                     </content>
                  </Tab>

               </tabs>
            </TabPane>
         </children>
      </VBox>
   </center>
</BorderPane>
